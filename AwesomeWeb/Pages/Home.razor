@page "/"
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]

<PageTitle>Demo</PageTitle>

<div class="page-shell">
    <h1>SSE demo: With Authentication</h1>

    <div class="panel-grid">
        <div class="endpoint-panel">
            <h2>Using JS</h2>

            <div class="counter-box">
                <span class="counter-label">Latest value</span>
                <strong>@_lastValue</strong>
            </div>

            <div class="button-row">
                <button class="primary" @onclick='() => StartEndpoint("1")'>
                    Start
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <p class="error-message">@_error</p>
            }
        </div>
        <div class="endpoint-panel">
            <h2>Using HttpClient</h2>

            <div class="button-row">
                <button @onclick="CallApi">Call API</button>
            </div>
        </div>
    </div>
    
    <div class="panel-grid">
        <div class="endpoint-panel">
            <h2>Using JS - With Library</h2>

            <div class="counter-box">
                <span class="counter-label">Latest value</span>
                <strong>@_lastValue</strong>
            </div>

            <div class="button-row">
                <button class="primary" @onclick='() => StartAuthenticatedEndpoint("2")'>
                    Start
                </button>
            </div>

            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <p class="error-message">@_error</p>
            }
        </div>
        <div class="endpoint-panel">
           
        </div>
    </div>
</div>

<style>
    .page-shell {
        max-width: 1100px;
        margin: 0 auto;
        padding: 2rem;
        font-family: sans-serif;
    }

    h1 {
        margin-bottom: 1.5rem;
    }

    .panel-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .endpoint-panel {
        background: #f8fafc;
        border: 1px solid #dbe4ee;
        border-radius: 12px;
        padding: 1.25rem;
        box-shadow: 0 2px 8px rgba(15, 23, 42, 0.06);
    }

    .endpoint-panel h2 {
        margin-top: 0;
        margin-bottom: 0.75rem;
    }

    .endpoint-url {
        margin: 0 0 1rem;
        color: #475569;
        font-size: 0.95rem;
        word-break: break-all;
    }

    .status-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 1rem;
    }

    .status-label {
        color: #334155;
        font-weight: 600;
    }

    .status-value {
        font-weight: 700;
    }

    .status-value.connected {
        color: #15803d;
    }

    .status-value.stopped {
        color: #475569;
    }

    .counter-box {
        background: #ffffff;
        border: 1px solid #dfe6ee;
        border-radius: 10px;
        padding: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.35rem;
        margin-bottom: 1rem;
    }

    .counter-label {
        font-size: 0.8rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 0.05em;
    }

    .counter-box strong {
        font-size: 2rem;
        color: #0f172a;
    }

    .button-row {
        display: flex;
        gap: 0.75rem;
    }

    button {
        border: none;
        border-radius: 8px;
        padding: 0.7rem 1rem;
        font-size: 0.96rem;
        font-weight: 600;
        cursor: pointer;
        transition: opacity 0.2s ease;
    }

    button:disabled {
        opacity: 0.55;
        cursor: not-allowed;
    }

    .primary {
        background: #2563eb;
        color: white;
    }

    .secondary {
        background: #e2e8f0;
        color: #0f172a;
    }

    .error-message {
        margin-top: 1rem;
        color: #b91c1c;
        font-weight: 600;
    }
</style>